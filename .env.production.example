# ==============================================================================
# XONIT POS & ERP - BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# Optimized for: 4 vCPU | 8 GB RAM | 100 GB SSD Single VPS
# ==============================================================================

# ─── 1. Database (PostgreSQL 16) ──────────────────────────────────────────────
# Replace <DB_PASSWORD> with the password generated by scripts/vps-init.sh
DATABASE_URL="postgresql://xonit_user:<DB_PASSWORD>@127.0.0.1:5432/xonit_pos_db?schema=public"

# ─── 2. Redis Cache & Job Queues (Redis 7) ────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"

# ─── 3. Application Runtime ──────────────────────────────────────────────────
NODE_ENV="production"
PORT=5000
API_BASE_URL="https://yourdomain.com/api/v1"

# ─── 4. CORS & Domains ────────────────────────────────────────────────────────
# In production with unified Nginx reverse proxy, frontend and API share the domain
FRONTEND_URL="https://yourdomain.com"
STOREFRONT_URL="https://yourdomain.com"
ADMIN_URL="https://yourdomain.com"
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# ─── 5. Authentication & Cryptographic Keys (RS256) ──────────────────────────
# Generate with: npx ts-node scripts/generate-jwt-keys.ts
JWT_PRIVATE_KEY="base64_encoded_private_key_here"
JWT_PUBLIC_KEY="base64_encoded_public_key_here"
JWT_ACCESS_EXPIRY="1h"
JWT_REFRESH_EXPIRY="7d"

# ─── 6. Security & DDoS Protection ────────────────────────────────────────────
# Cloudflare Turnstile CAPTCHA (Optional / Production)
# Test secret key (always passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Admin IP Whitelist (Optional: leave empty to allow all)
ADMIN_ALLOWED_IPS=""

# ─── 7. Media & Storage (Optional: AWS S3 or Local Uploads) ───────────────────
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_S3_ENDPOINT=""

# ─── 8. Third-Party Integrations (Optional) ───────────────────────────────────
FARDAR_API_URL="https://api.fardar.com/v1"
FARDAR_API_KEY=""
FARDAR_CLIENT_ID=""
