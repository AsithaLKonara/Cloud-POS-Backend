# ==========================================
# LAURAL CLOTHING - BACKEND ENVIRONMENT VARIABLES
# ==========================================

# ─── Database ────────────────────────────────────────────────────────────────
# Prisma PostgreSQL Database
DATABASE_URL="postgresql://user:password@localhost:5432/laural_backend"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis / Queue
REDIS_URL=redis://localhost:6379

# Fardar Courier API Integration
FARDAR_API_URL=https://api.fardar.com/v1
FARDAR_API_KEY=your_fardar_api_key_here
FARDAR_CLIENT_ID=your_fardar_client_id_here

# ─── Runtime Environment ──────────────────────────────────────────────────────
NODE_ENV="development"  # Set to "production" in production
PORT=5000
API_BASE_URL="http://localhost:5000"

# ─── Security ────────────────────────────────────────────────────────────────

# Admin IP Whitelist (comma-separated, leave empty or "*" to allow all)
# Example: "203.0.113.10,203.0.113.20"
ADMIN_ALLOWED_IPS=""

# Cloudflare Turnstile CAPTCHA (server-side secret key)
# Get from: https://dash.cloudflare.com → Turnstile → your site → Secret Key
# Test secret (always passes): 1x0000000000000000000000000000000AA
# Test secret (always fails):  2x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY="your_turnstile_secret_key_here"

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
# RS256 JWT Keys (Base64 encoded PEM strings)
# Generate with: node scripts/generate-jwt-keys.ts
JWT_PRIVATE_KEY="base64_encoded_private_key_here"
JWT_PUBLIC_KEY="base64_encoded_public_key_here"
JWT_ACCESS_EXPIRY="1h"
JWT_REFRESH_EXPIRY="7d"

# ─── CORS Allowlist ──────────────────────────────────────────────────────────
# Frontend / Admin URLs (used for CORS allowlist)
FRONTEND_URL="http://localhost:3000"
STOREFRONT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# ─── Storage (AWS S3) ────────────────────────────────────────────────────────
# AWS S3 (Media Storage + Encrypted DB Backups)
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_S3_BUCKET_NAME="laural-media-bucket"
AWS_S3_REGION="auto"
AWS_S3_ENDPOINT=""
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""

# ─── Backups ─────────────────────────────────────────────────────────────────
# Encrypted DB Backup (GPG passphrase for pg_dump backups uploaded to S3)
# Store this securely — losing it means you can't decrypt your backups
BACKUP_ENCRYPTION_KEY="your_secure_gpg_passphrase_here"

# ─── Alerts & Logging ────────────────────────────────────────────────────────
# Slack Webhook for security alerts (brute-force, fraud, weekly audit digest)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"

# Grafana Loki Logging
LOKI_HOST="http://loki:3100"
LOKI_AUTH="username:password"

# ─── Notifications (Push & SMS) ──────────────────────────────────────────────
# Web Push VAPID Keys
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"

# Send.lk SMS Gateway
SEND_LK_API_KEY="your_send_lk_api_key"
SEND_LK_SENDER_ID="LAURAL"

# ─── Payment Gateways ────────────────────────────────────────────────────────
# OnePay
ONEPAY_APP_ID=""
ONEPAY_APP_TOKEN=""
ONEPAY_HASH_SALT=""
ONEPAY_API_URL="https://merchantapi.onepay.lk/v1/checkout/request/"

PAYMENT_WEBHOOK_SECRET=laural-clothing-mock-secret

# Koko Payment
KOKO_API_URL="https://qaapi.paykoko.com"
KOKO_MERCHANT_ID=""
KOKO_API_KEY=""
KOKO_PUBLIC_KEY=""
KOKO_PRIVATE_KEY=""

# Rate Limiting & CAPTCHA (set to false to disable for testing)
ENABLE_RATE_LIMIT=true
ENABLE_CAPTCHA=true
