generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BusinessType {
  RETAIL
  RESTAURANT_CAFE
  SALON_SPA
  PHARMACY_CLINIC
  GROCERY_SUPERMARKET
  AUTOMOTIVE_SERVICES
  WHOLESALE_DISTRIBUTION
  GENERAL_SERVICES
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

model Tenant {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  businessType     BusinessType    @default(RETAIL)
  status           TenantStatus    @default(ACTIVE)
  currency         String          @default("LKR")
  currencySymbol   String          @default("Rs.")
  timezone         String          @default("Asia/Colombo")
  taxRate          Float           @default(0.0)
  logoUrl          String?
  subscriptionTier String          @default("STANDARD")
  maxBranches      Int             @default(3)
  maxUsers         Int             @default(10)
  settings         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  users            User[]
  branches         Branch[]
  categories       Category[]
  products         Product[]
  posTerminals     PosTerminal[]
  posSessions      PosSession[]
  orders           Order[]
  customers        Customer[]
  expenses         BranchExpense[]
  auditLogs        AuditLog[]
  coupons          Coupon[]
  diningTables     DiningTable[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]
  inventoryBatches InventoryBatch[]
  stockTransfers   StockTransfer[]

  @@index([slug])
  @@index([status])
}

model Category {
  id             String          @id @default(uuid())
  name           String
  slug           String
  description    String?
  tenantId       String?
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  imageUrl       String?
  status         String          @default("Active")
  legacyProducts LegacyProduct[]
  products       Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model LegacyProduct {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String?
  excerpt       String?
  price         Float
  salePrice     Float?
  sku           String?   @unique
  stockStatus   String    @default("instock")
  quantity      Int       @default(0)
  featuredImage String?
  gallery       String[]
  categoryId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  category      Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("LegacyProduct")
}

model Product {
  id                String              @id @default(uuid())
  name              String
  slug              String
  barcode           String?
  description       String?
  excerpt           String?
  categoryId        String?
  tenantId          String?
  tenant            Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allowedPaymentMethods String[]        @default(["COD", "Mintpay", "Koko", "Payzy", "OnePay"])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sizeGuideContent  String?
  sizeGuideEnabled  Boolean             @default(false)
  sizeGuideImageUrl String?
  status            String              @default("ACTIVE")
  productType       String              @default("PHYSICAL") // PHYSICAL, SERVICE, DIGITAL, BUNDLE, LUBRICANT, etc.
  trackInventory    Boolean             @default(true)      // false for services, appointments, digital items
  unit              String              @default("PIECE")   // PIECE, KG, GRAM, LITER, ML, HOUR, SERVICE, BOX, PACK
  brand             String?
  attributes        Json?               // Universal dynamic industry-specific attributes
  viscosity         String?             // e.g. 0W-20, 5W-30, 10W-40, 15W-40, 20W-50, SAE 90, ATF, DOT 4 (null for non-oil)
  oilType           String?             // e.g. Full Synthetic, Semi-Synthetic, Mineral, Heavy Duty Diesel (null for non-oil)
  apiStandard       String?             // e.g. API SP, ILSAC GF-6, ACEA C3, JASO MA2
  partNumber        String?             // e.g. OEM / Part # for filters, batteries, plugs
  compatibleVehicles String?            // e.g. Applicable vehicle models/engines
  collections       CollectionProduct[]
  category          Category?           @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  reviews           Review[]
  wishlistItems     WishlistItem[]

  @@unique([tenantId, slug])
  @@index([categoryId])
  @@index([createdAt])
  @@index([productType])
  @@index([brand])
  @@index([tenantId])
  @@index([tenantId, barcode])
}

model ProductVariant {
  id                 String                 @id @default(uuid())
  productId          String
  name               String?
  sku                String?                @unique
  barcode            String?                @unique
  price              Float
  salePrice          Float?
  costPrice          Float                  @default(0)
  wholesalePrice     Float?
  unit               String?                // Specific unit for this variant (e.g. 1L, 4L, KG, Hour, Single, Pack of 4)
  attributes         Json?                  // Variant-specific dynamic attributes (e.g. { size: "XL", color: "Red" })
  packUnit           String?                // e.g. 1L, 4L, 5L, 20L, 208L Drum, Piece, Can, Bottle, Box, Liter Dispensed
  unitVolumeLiters   Float?                 // Volume in liters for bulk/dispensing calculations
  stockStatus        String                 @default("instock")
  quantity           Int                    @default(0)
  color              String?
  size               String?
  featuredImage      String?
  gallery            String[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  cartItems          CartItem[]
  flashSaleItems     FlashSaleItem[]
  inventoryItems     InventoryItem[]
  transactions       InventoryTransaction[]
  orderItems         OrderItem[]
  product            Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockTransfers     StockTransfer[]
  returnItems        ReturnItem[]
  purchaseOrderItems PurchaseOrderItem[]
  inventoryBatches   InventoryBatch[]

  @@index([productId])
}

model Branch {
  id           String                 @id @default(uuid())
  name         String
  code         String
  tenantId     String?
  tenant       Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  address      String?
  phone        String?
  type         String                 @default("RETAIL")
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  managerId    String?                @unique
  manager      User?                  @relation("BranchManager", fields: [managerId], references: [id])
  inventory    InventoryItem[]
  transactions InventoryTransaction[]
  orders       Order[]
  posSessions  PosSession[]
  posTerminals PosTerminal[]
  transfersOut StockTransfer[]        @relation("FromBranch")
  transfersIn  StockTransfer[]        @relation("ToBranch")
  staff        User[]                 @relation("BranchStaff")
  expenses     BranchExpense[]
  diningTables DiningTable[]
  purchaseOrders   PurchaseOrder[]
  inventoryBatches InventoryBatch[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PosTerminal {
  id        String       @id @default(uuid())
  name      String
  status    String       @default("ACTIVE")
  branchId  String
  tenantId  String?
  tenant    Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sessions  PosSession[]
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
}

model PosSession {
  id               String      @id @default(uuid())
  branchId         String
  terminalId       String
  userId           String
  tenantId         String?
  tenant           Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status           String      @default("OPEN")
  openingFloat     Float       @default(0)
  expectedClosing  Float?
  actualClosing    Float?
  variance         Float?
  totalCashSales   Float?      @default(0)
  totalCardSales   Float?      @default(0)
  totalCreditSales Float?      @default(0)
  closingNotes     String?
  openedAt         DateTime    @default(now())
  closedAt         DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orders           Order[]
  branch           Branch      @relation(fields: [branchId], references: [id])
  terminal         PosTerminal @relation(fields: [terminalId], references: [id])
  user             User        @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([branchId])
  @@index([terminalId])
  @@index([userId])
}

model ExchangeVoucher {
  id        String    @id @default(uuid())
  code      String    @unique
  value     Float
  status    String    @default("ACTIVE")
  orderId   String?
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  order     Order?    @relation("OrderVoucher", fields: [orderId], references: [id])
}

model InventoryItem {
  id                String         @id @default(uuid())
  variantId         String
  quantity          Int            @default(0)
  reservedQty       Int            @default(0)
  lowStockThreshold Int            @default(5)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  branchId          String
  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, branchId])
  @@index([variantId])
  @@index([branchId])
}

model InventoryTransaction {
  id             String         @id @default(uuid())
  variantId      String
  type           String
  quantityChange Int
  reason                  String?
  reference               String?
  costPriceAtTransaction  Float?
  createdAt               DateTime       @default(now())
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@index([branchId, createdAt])
  @@index([variantId])
}

model StockTransfer {
  id           String         @id @default(uuid())
  tenantId     String?
  tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId    String
  quantity     Int
  status       String         @default("REQUESTED") // REQUESTED, APPROVED, IN_TRANSIT, RECEIVED, REJECTED, CANCELLED
  requestedBy  String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  fromBranchId String
  toBranchId   String
  fromBranch   Branch         @relation("FromBranch", fields: [fromBranchId], references: [id])
  toBranch     Branch         @relation("ToBranch", fields: [toBranchId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@index([tenantId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([variantId])
}

model Supplier {
  id             String          @id @default(uuid())
  tenantId       String?
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  code           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  taxNumber      String?
  paymentTerms   String?         @default("NET_30")
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  tenantId       String?
  tenant         Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poNumber       String
  supplierId     String
  branchId       String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  branch         Branch              @relation(fields: [branchId], references: [id])
  status         String              @default("DRAFT") // DRAFT, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  subtotal       Float               @default(0)
  tax            Float               @default(0)
  total          Float               @default(0)
  expectedDate   DateTime?
  notes          String?
  items          PurchaseOrderItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([branchId])
}

model PurchaseOrderItem {
  id                String         @id @default(uuid())
  purchaseOrderId   String
  variantId         String
  quantityOrdered   Int
  quantityReceived  Int            @default(0)
  unitCost          Float
  totalCost         Float
  batchNumber       String?
  expiryDate        DateTime?
  purchaseOrder     PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
  @@index([variantId])
}

model InventoryBatch {
  id              String         @id @default(uuid())
  tenantId        String?
  tenant          Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId       String
  branchId        String
  batchNumber     String
  expiryDate      DateTime?
  initialQuantity Int
  currentQuantity Int
  costPrice       Float          @default(0)
  status          String         @default("ACTIVE") // ACTIVE, EXPIRED, DEPLETED
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  branch          Branch         @relation(fields: [branchId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tenantId, branchId, variantId, batchNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([variantId])
  @@index([expiryDate])
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  name              String?
  tenantId          String?
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  branchId          String?
  birthday          DateTime?
  phone             String?
  status            String             @default("ACTIVE")
  auditLogs         AuditLog[]
  managedBranch     Branch?            @relation("BranchManager")
  posSessions       PosSession[]
  pushSubscriptions PushSubscription[]
  refreshTokens     RefreshToken[]
  branch            Branch?            @relation("BranchStaff", fields: [branchId], references: [id])
  userRoles         UserRole[]
  loggedExpenses    BranchExpense[]

  @@index([tenantId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  status      String           @default("Active")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  module      String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Collection {
  id          String              @id @default(uuid())
  title       String
  slug        String              @unique
  description String?
  type        CollectionType      @default(MANUAL)
  status      String              @default("Active")
  rules       Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  imageUrl    String?
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

model Customer {
  id                 String                 @id @default(uuid())
  phone              String
  email              String?
  firstName          String?
  lastName           String?
  companyName        String?
  customerType       String                 @default("RETAIL") // RETAIL, WHOLESALE, CORPORATE, COMMERCIAL, VIP
  tags               String[]               @default([])
  birthday           DateTime?
  gender             String?
  taxNumber          String?
  creditLimit        Float                  @default(0)
  creditBalance      Float                  @default(0)
  vehicleNumber      String?
  notes              String?
  metadata           Json?
  isGuest            Boolean                @default(false)
  tenantId           String?
  tenant             Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  addresses          Address[]
  carts              Cart[]
  loyaltyAccount     LoyaltyAccount?
  orders             Order[]
  payments           PaymentTransaction[]
  returnRequests     ReturnRequest[]
  reviews            Review[]
  wishlist           Wishlist?
  creditTransactions CustomerCreditLedger[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model CustomerCreditLedger {
  id            String    @id @default(uuid())
  customerId    String
  orderId       String?
  type          String    // CHARGE, SETTLEMENT, ADJUSTMENT
  amount        Float
  balanceAfter  Float
  paymentMethod String?   // CASH, CARD, BANK_TRANSFER, CHEQUE
  reference     String?   // Invoice #, Cheque #, Bank ref
  notes         String?
  createdAt     DateTime  @default(now())
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model Address {
  id           String   @id @default(uuid())
  customerId   String
  type         String   @default("SHIPPING")
  firstName    String
  lastName     String
  addressLine1 String
  addressLine2 String?
  addressLine3 String?
  city         String
  district     String?
  postalCode   String?
  nearestCity  String?
  phone        String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Cart {
  id         String     @id @default(uuid())
  sessionId  String?    @unique
  customerId String?
  status     String     @default("ACTIVE")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer?  @relation(fields: [customerId], references: [id])
  items      CartItem[]
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Order {
  id                  String               @id @default(uuid())
  orderNumber         String
  customerId          String?
  tenantId            String?
  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status              String               @default("PENDING")
  paymentMethod       String?
  paymentStatus       String               @default("UNPAID")
  subtotal            Float
  shippingFee         Float
  discount            Float                @default(0)
  tax                 Float                @default(0)
  total               Float
  shippingAddress     Json?
  billingAddress      Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  branchId            String?
  posSessionId        String?
  type                String               @default("ECOMMERCE")
  trackingNumber      String?
  labelUrl            String?
  trackingUrl         String?
  fraudScore          Float                @default(0)
  fraudSignals        Json?
  riskLevel           String               @default("LOW")
  loyaltyDiscount     Float                @default(0)
  diningOption        String?              @default("TAKEAWAY")
  tableId             String?
  diningTable         DiningTable?         @relation(fields: [tableId], references: [id], onDelete: SetNull)
  splitPayments       Json?
  metadata            Json?
  parentOrderId       String?
  appliedVouchers     ExchangeVoucher[]    @relation("OrderVoucher")
  loyaltyTransactions LoyaltyTransaction[]
  branch              Branch?              @relation(fields: [branchId], references: [id])
  customer            Customer?            @relation(fields: [customerId], references: [id])
  posSession          PosSession?          @relation(fields: [posSessionId], references: [id])
  items               OrderItem[]
  payments            PaymentTransaction[]
  returnRequests      ReturnRequest[]

  @@unique([tenantId, orderNumber])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([branchId])
  @@index([tenantId])
  @@index([tableId])
}

model OrderItem {
  id                  String         @id @default(uuid())
  orderId             String
  variantId           String
  quantity            Int
  dispensedVolumeLiters Float?
  priceAtPurchase     Float
  costPriceAtPurchase Float          @default(0)
  notes               String?
  staffId             String?
  modifiers           Json?
  attributes          Json?
  createdAt           DateTime       @default(now())
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant             ProductVariant @relation(fields: [variantId], references: [id])
  returnItems         ReturnItem[]

  @@index([orderId])
  @@index([variantId])
}

model DiningTable {
  id             String         @id @default(uuid())
  name           String
  zone           String         @default("MAIN")
  capacity       Int            @default(4)
  status         String         @default("AVAILABLE")
  branchId       String
  tenantId       String?
  tenant         Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders         Order[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([tenantId, branchId, name])
  @@index([tenantId])
  @@index([branchId])
}

model ReturnRequest {
  id           String       @id @default(uuid())
  rmaId        String       @unique
  orderId      String?
  customerId   String?
  status       String       @default("REQUESTED")
  reason       String?
  customerNote String?
  adminNote    String?
  refundAmount Float        @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        ReturnItem[]
  customer     Customer?    @relation(fields: [customerId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([customerId])
}

model ReturnItem {
  id               String        @id @default(uuid())
  returnRequestId  String
  orderItemId      String?
  variantId        String?
  quantity         Int
  condition        String?
  inspectionStatus String        @default("PENDING")
  createdAt        DateTime      @default(now())
  orderItem        OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  returnRequest    ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@index([orderItemId])
}

model HeroSlide {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  cta       String?
  ctaLink   String?
  image     String
  active    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id          String   @id @default(uuid())
  text        String
  link        String?
  bgColor     String   @default("#1c1c1c")
  active      Boolean  @default(false)
  type        String   @default("PROMO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?
  showOverlay Boolean  @default(true)
}

model HomepageSection {
  id          String   @id @default(uuid())
  name        String
  description String?
  visible     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  config      Json?
  type        String   @default("STATIC")
}

model StaticPage {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  content         String
  lastEdited      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metaDescription String?
  metaKeywords    String?
  metaTitle       String?
  ogImage         String?
}

model Coupon {
  id         String    @id @default(uuid())
  name       String
  code       String
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       String    @default("PERCENTAGE")
  value      Float
  usageLimit Int?
  usedCount  Int       @default(0)
  expiryDate DateTime?
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model FlashSale {
  id          String          @id @default(uuid())
  name        String
  description String?
  discount    Float
  status      String          @default("ACTIVE")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       FlashSaleItem[]
}

model FlashSaleItem {
  id          String         @id @default(uuid())
  flashSaleId String
  variantId   String
  salePrice   Float
  createdAt   DateTime       @default(now())
  flashSale   FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([flashSaleId, variantId])
}

model MediaFile {
  id         String   @id @default(uuid())
  name       String
  type       String
  folder     String   @default("Uncategorized")
  size       Int
  dimensions String?
  url        String
  key        String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Review {
  id                 String       @id @default(uuid())
  productId          String
  customerId         String
  rating             Int
  title              String?
  comment            String?
  images             String[]
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  adminReply         String?
  spamFlagged        Boolean      @default(false)
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([customerId])
}

model Wishlist {
  id         String         @id @default(uuid())
  sessionId  String?        @unique
  customerId String?        @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  customer   Customer?      @relation(fields: [customerId], references: [id])
  items      WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

model Setting {
  key         String   @id
  value       String
  type        String   @default("string")
  group       String   @default("general")
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentTransaction {
  id         String    @id @default(uuid())
  orderId    String
  customerId String?
  gateway    String
  method     String
  amount     Float
  status     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer? @relation(fields: [customerId], references: [id])
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([customerId])
}

model IdempotencyKey {
  key       String   @id
  createdAt DateTime @default(now())
}

model LoyaltyAccount {
  id             String               @id @default(uuid())
  customerId     String               @unique
  points         Int                  @default(0)
  lifetimePoints Int                  @default(0)
  tier           String               @default("Bronze")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions   LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String         @id @default(uuid())
  accountId String
  amount    Int
  type      String
  reason    String?
  orderId   String?
  createdAt DateTime       @default(now())
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order     Order?         @relation(fields: [orderId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum CollectionType {
  MANUAL
  AUTOMATED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model BranchExpense {
  id          String    @id @default(uuid())
  branchId    String
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    String    // RENT, ELECTRICITY, WATER, SALARY, MAINTENANCE, EQUIPMENT, SUPPLIES, MARKETING, OTHER
  title       String
  amount      Float
  date        DateTime  @default(now())
  notes       String?
  receiptUrl  String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([branchId, date])
}
